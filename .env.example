# Contact form recipient email
VITE_CONTACT_EMAIL=disney.mio@icloud.com

# Admin Studio Username (Default: Midlaj)
VITE_ADMIN_USERNAME=Midlaj

# Admin Studio Password SHA-256 Hash
# Generate via: node -e "console.log(require('crypto').createHash('sha256').update('your_password').digest('hex'))"
# Default below corresponds to initial setup:
VITE_ADMIN_PASSWORD_HASH=ab4e657e3fa9f5e6670e7f5a03b2b998f945234ffa679de4fc0863b72cdfb2b3

# Set to true to exclude admin.html and admin.js completely from production builds
VITE_EXCLUDE_ADMIN=false
